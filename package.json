{
  "name": "tenex",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @tenex/api dev\" \"pnpm --filter @tenex/web dev\"",
    "build": "pnpm --filter @tenex/shared build && pnpm --filter @tenex/api build && pnpm --filter @tenex/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
